{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "remote-control/control-message-v1",
  "type": "object",
  "required": ["protocolVersion", "requestId", "type"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "requestId": { "type": "string", "minLength": 1 },
    "type": { "enum": ["health", "pointer", "mouseButton", "wheel", "key", "viewport", "connectionState", "error"] },
    "payload": { "type": "object" }
  },
  "additionalProperties": false
}
