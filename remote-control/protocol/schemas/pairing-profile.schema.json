{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "remote-control/pairing-profile-v1",
  "type": "object",
  "required": ["protocolVersion", "deviceId", "deviceName", "endpoints", "transport", "pairingToken", "sessionKeyBase64", "publicKeyFingerprint", "expiresAt"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "deviceId": { "type": "string", "minLength": 8 },
    "deviceName": { "type": "string", "minLength": 1 },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["mode", "url"],
        "properties": {
          "mode": { "enum": ["LAN", "VPN", "PublicDirect", "Relay"] },
          "url": { "type": "string", "format": "uri" }
        },
        "additionalProperties": false
      }
    },
    "transport": { "type": "string", "minLength": 1 },
    "pairingToken": { "type": "string", "minLength": 32 },
    "sessionKeyBase64": { "type": "string", "minLength": 40 },
    "publicKeyFingerprint": { "type": "string", "minLength": 16 },
    "expiresAt": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
